<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_ticketmaton">
        <field name="name">Ticketmaton</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_ticketmaton_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ticketmaton"/>
    </record>

    <record id="group_ticketmaton_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ticketmaton"/>
        <field name="implied_ids" eval="[(4, ref('group_ticketmaton_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_ticketmaton_station_company" model="ir.rule">
        <field name="name">Estaciones por empresa</field>
        <field name="model_id" ref="model_ticketmaton_station"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ticketmaton_ticket_company" model="ir.rule">
        <field name="name">Tickets por empresa</field>
        <field name="model_id" ref="model_ticketmaton_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
