<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ticketmaton_queue_form" model="ir.ui.view">
        <field name="name">ticketmaton.queue.form</field>
        <field name="model">ticketmaton.queue</field>
        <field name="arch" type="xml">
            <form string="Cola">
                <header>
                    <button name="action_call_next" type="object" string="Siguiente" class="btn-primary"/>
                    <button name="action_recall_current" type="object" string="Rellamar" class="btn-secondary"/>
                    <button name="action_reset_counter" type="object" string="Reset contador" class="btn-warning"
                            confirm="¿Resetear contador de esta cola?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="station_id"/>
                            <field name="code"/>
                            <field name="active"/>
                            <field name="waiting_count"/>
                            <field name="counter_value" readonly="1"/>
                            <field name="counter_segment_index" readonly="1"/>
                        </group>
                        <group string="Boton kiosco">
                            <field name="button_label"/>
                            <field name="button_color" widget="color"/>
                            <field name="button_text_color" widget="color"/>
                            <field name="button_icon"/>
                            <field name="color" widget="color"/>
                        </group>
                    </group>
                    <group string="Numeracion">
                        <group>
                            <field name="sequence_type"/>
                            <field name="prefix" invisible="sequence_type == 'numeric'"/>
                            <field name="padding"/>
                            <field name="min_value"/>
                            <field name="max_value"/>
                            <field name="reset_policy"/>
                            <field name="last_reset_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="multi_segment_rules" invisible="sequence_type != 'multi_segment'"
                                   widget="text" placeholder='[{"prefix":"A","min":0,"max":99,"padding":2}]'/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ticketmaton_queue_list" model="ir.ui.view">
        <field name="name">ticketmaton.queue.list</field>
        <field name="model">ticketmaton.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="station_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="sequence_type"/>
                <field name="counter_value"/>
                <field name="waiting_count"/>
                <button name="action_call_next" type="object" string="Siguiente" icon="fa-forward"/>
            </list>
        </field>
    </record>

    <record id="action_ticketmaton_queue" model="ir.actions.act_window">
        <field name="name">Colas</field>
        <field name="res_model">ticketmaton.queue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
